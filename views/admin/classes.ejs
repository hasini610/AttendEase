<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Classes & Sections</h1>
                    <p class="hero-sub-title">Configure student batches, departmental sections, and semester alignments</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#addClassModal">
                        <i class="bi bi-door-closed-fill me-2"></i>+ Add Class / Section
                    </button>
                </div>
            </div>

            <!-- CLASSES TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Active Classes (<%= classes.length %>)</h2>
                    <span class="badge-status-lime">Academic Sections</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Class / Section</th>
                                <th>Department</th>
                                <th>Semester</th>
                                <th>Academic Year</th>
                                <th>Enrolled Students</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (classes && classes.length > 0) { %>
                                <% classes.forEach(c => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14">
                                            <span class="badge-pill-soft me-2"><%= c.name %></span>
                                        </div>
                                    </td>
                                    <td><span class="fw-semibold text-dark"><%= c.dept_code %></span> - <%= c.department_name %></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary rounded-pill px-3"><%= c.semester_name %></span></td>
                                    <td><code><%= c.year_label %></code></td>
                                    <td><span class="fw-bold text-dark"><%= c.student_count %></span> students</td>
                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary rounded-pill me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editClassModal<%= c.id %>"
                                            title="Edit Class"
                                        >
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form action="/admin/classes/<%= c.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete class <%= c.name %>?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- EDIT CLASS MODAL -->
                                <div class="modal fade" id="editClassModal<%= c.id %>" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content aesthetic-white-card p-4 border-0">
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                                                <h3 class="card-section-title mb-0">Edit Class / Section</h3>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form action="/admin/classes/<%= c.id %>/edit" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Class / Section Name *</label>
                                                    <input type="text" name="name" class="form-control pill-input" value="<%= c.name %>" required>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Department *</label>
                                                    <select name="department_id" class="form-select pill-input" required>
                                                        <% departments.forEach(d => { %>
                                                            <option value="<%= d.id %>" <%= c.department_id == d.id ? 'selected' : '' %>>
                                                                <%= d.code %> - <%= d.name %>
                                                            </option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                                <div class="row g-2 mb-4">
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Semester *</label>
                                                        <select name="semester_id" class="form-select pill-input" required>
                                                            <% semesters.forEach(s => { %>
                                                                <option value="<%= s.id %>" <%= c.semester_id == s.id ? 'selected' : '' %>><%= s.name %></option>
                                                            <% }) %>
                                                        </select>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Academic Year *</label>
                                                        <select name="academic_year_id" class="form-select pill-input" required>
                                                            <% (typeof acYears !== 'undefined' ? acYears : academicYears).forEach(ay => { %>
                                                                <option value="<%= ay.id %>" <%= c.academic_year_id == ay.id ? 'selected' : '' %>><%= ay.year_label %></option>
                                                            <% }) %>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-navy-pill">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">No classes configured yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ADD CLASS MODAL -->
<div class="modal fade" id="addClassModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Create New Class</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/classes/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Class / Section Name *</label>
                    <input type="text" name="name" class="form-control pill-input" placeholder="e.g. CSE-C or ECE-B" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Department *</label>
                    <select name="department_id" class="form-select pill-input" required>
                        <option value="">Select Dept</option>
                        <% departments.forEach(d => { %>
                            <option value="<%= d.id %>"><%= d.code %> - <%= d.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Semester *</label>
                        <select name="semester_id" class="form-select pill-input" required>
                            <% semesters.forEach(s => { %>
                                <option value="<%= s.id %>"><%= s.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Academic Year *</label>
                        <select name="academic_year_id" class="form-select pill-input" required>
                            <% acYears.forEach(y => { %>
                                <option value="<%= y.id %>"><%= y.year_label %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Create Class</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
