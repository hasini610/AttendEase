<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Faculty Directory</h1>
                    <p class="hero-sub-title">Manage professors, department affiliations, designations, and class assignments</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#addFacultyModal">
                        <i class="bi bi-person-badge-fill me-2"></i>+ Add New Faculty
                    </button>
                </div>
            </div>

            <!-- FACULTY TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Registered Faculty Members (<%= facultyMembers.length %>)</h2>
                    <span class="badge-status-lime">Teaching Staff</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Faculty Member</th>
                                <th>Employee ID</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Classes Taught</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (facultyMembers && facultyMembers.length > 0) { %>
                                <% facultyMembers.forEach(f => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle" style="width: 36px; height: 36px; font-size: 14px; background: #cbf946; color: #1e1940;">
                                                <%= f.full_name ? f.full_name.charAt(0).toUpperCase() : 'F' %>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark"><%= f.full_name %></div>
                                                <small class="text-muted"><%= f.email %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code><%= f.employee_id %></code></td>
                                    <td><span class="badge-pill-soft"><%= f.dept_code %></span> <%= f.department_name %></td>
                                    <td><span class="fw-semibold text-dark"><%= f.designation || 'Lecturer' %></span></td>
                                    <td>
                                        <span class="fw-bold text-dark"><%= f.assigned_classes_count %></span> subjects
                                    </td>
                                    <td>
                                        <form action="/admin/faculty/<%= f.faculty_id %>/toggle" method="POST" style="display:inline;">
                                            <button type="submit" class="border-0 bg-transparent p-0" title="Click to toggle active status">
                                                <% if (f.is_active) { %>
                                                    <span class="badge-status-lime">Active</span>
                                                <% } else { %>
                                                    <span class="badge-status-danger">Inactive</span>
                                                <% } %>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary rounded-pill me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editFacultyModal<%= f.faculty_id %>"
                                            title="Edit Faculty"
                                        >
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form action="/admin/faculty/<%= f.faculty_id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Remove faculty <%= f.full_name %>?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete Faculty">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- EDIT MODAL -->
                                <div class="modal fade" id="editFacultyModal<%= f.faculty_id %>" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content aesthetic-white-card p-4 border-0">
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                                                <h3 class="card-section-title mb-0">Edit Faculty Member</h3>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form action="/admin/faculty/<%= f.faculty_id %>/edit" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Full Name</label>
                                                    <input type="text" name="full_name" class="form-control pill-input" value="<%= f.full_name %>" required>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Employee ID</label>
                                                        <input type="text" name="employee_id" class="form-control pill-input" value="<%= f.employee_id %>" required>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Phone</label>
                                                        <input type="text" name="phone" class="form-control pill-input" value="<%= f.phone || '' %>">
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Email Address</label>
                                                    <input type="email" name="email" class="form-control pill-input" value="<%= f.email %>" required>
                                                </div>
                                                <div class="row g-2 mb-4">
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Department</label>
                                                        <select name="department_id" class="form-select pill-input" required>
                                                            <% departments.forEach(d => { %>
                                                                <option value="<%= d.id %>" <%= f.department_id == d.id ? 'selected' : '' %>>
                                                                    <%= d.code %> - <%= d.name %>
                                                                </option>
                                                            <% }) %>
                                                        </select>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Designation</label>
                                                        <input type="text" name="designation" class="form-control pill-input" value="<%= f.designation || 'Assistant Professor' %>">
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-navy-pill">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">No faculty members registered.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- PAGINATION -->
                <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top-subtle">
                        <div class="text-muted fs-13">
                            Showing Page <strong><%= pagination.page %></strong> of <strong><%= pagination.totalPages %></strong> (<%= pagination.totalCount %> total faculty)
                        </div>
                        <nav aria-label="Faculty pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= pagination.page - 1 %>&dept=<%= filters.dept %>&q=<%= filters.q %>">
                                        <i class="bi bi-chevron-left me-1"></i>Prev
                                    </a>
                                </li>
                                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                                    <% if (p === 1 || p === pagination.totalPages || (p >= pagination.page - 2 && p <= pagination.page + 2)) { %>
                                        <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= p %>&dept=<%= filters.dept %>&q=<%= filters.q %>"><%= p %></a>
                                        </li>
                                    <% } else if (p === pagination.page - 3 || p === pagination.page + 3) { %>
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    <% } %>
                                <% } %>
                                <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= pagination.page + 1 %>&dept=<%= filters.dept %>&q=<%= filters.q %>">
                                        Next<i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

<!-- ADD FACULTY MODAL -->
<div class="modal fade" id="addFacultyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Add New Faculty Member</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/faculty/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Full Name *</label>
                    <input type="text" name="full_name" class="form-control pill-input" placeholder="e.g. Dr. Kavitha Reddy" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Employee ID *</label>
                        <input type="text" name="employee_id" class="form-control pill-input" placeholder="e.g. FAC004" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Phone Number</label>
                        <input type="text" name="phone" class="form-control pill-input" placeholder="e.g. 9876543210">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Email Address *</label>
                    <input type="email" name="email" class="form-control pill-input" placeholder="e.g. kavitha@svce.edu" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Department *</label>
                        <select name="department_id" class="form-select pill-input" required>
                            <option value="">Select Dept</option>
                            <% departments.forEach(d => { %>
                                <option value="<%= d.id %>"><%= d.code %> - <%= d.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Designation</label>
                        <input type="text" name="designation" class="form-control pill-input" placeholder="Assistant Professor">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Initial Password</label>
                    <input type="password" name="password" class="form-control pill-input" placeholder="Default: password123">
                    <small class="text-muted">If left blank, default is <code>password123</code></small>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Register Faculty</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
