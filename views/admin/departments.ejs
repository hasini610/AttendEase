<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">College Departments</h1>
                    <p class="hero-sub-title">Configure academic branches, student enrollments, and faculty affiliations</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#addDeptModal">
                        <i class="bi bi-building me-2"></i>+ Add Department
                    </button>
                </div>
            </div>

            <!-- DEPARTMENTS TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Active Departments (<%= departments.length %>)</h2>
                    <span class="badge-status-lime">Academic Units</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Department Name</th>
                                <th>Branch Code</th>
                                <th>Enrolled Students</th>
                                <th>Faculty Count</th>
                                <th>Curriculum Subjects</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (departments && departments.length > 0) { %>
                                <% departments.forEach(d => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14"><%= d.name %></div>
                                    </td>
                                    <td><span class="badge-pill-soft"><%= d.code %></span></td>
                                    <td><span class="fw-bold text-dark"><%= d.student_count %></span> students</td>
                                    <td><span class="fw-bold text-dark"><%= d.faculty_count %></span> staff</td>
                                    <td><span class="fw-bold text-dark"><%= d.subject_count %></span> courses</td>
                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary rounded-pill me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editDeptModal<%= d.id %>"
                                            title="Edit Department"
                                        >
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form action="/admin/departments/<%= d.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete department <%= d.name %>?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- EDIT MODAL -->
                                <div class="modal fade" id="editDeptModal<%= d.id %>" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content aesthetic-white-card p-4 border-0">
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                                                <h3 class="card-section-title mb-0">Edit Department</h3>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form action="/admin/departments/<%= d.id %>/edit" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Department Name *</label>
                                                    <input type="text" name="name" class="form-control pill-input" value="<%= d.name %>" required>
                                                </div>
                                                <div class="mb-4">
                                                    <label class="form-label fs-13 fw-semibold">Code / Abbreviation *</label>
                                                    <input type="text" name="code" class="form-control pill-input" value="<%= d.code %>" required>
                                                </div>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-navy-pill">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">No departments configured yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ADD DEPARTMENT MODAL -->
<div class="modal fade" id="addDeptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Add Department</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/departments/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Department Name *</label>
                    <input type="text" name="name" class="form-control pill-input" placeholder="e.g. Information Technology" required>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Branch Code *</label>
                    <input type="text" name="code" class="form-control pill-input" placeholder="e.g. IT" required>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Create Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
