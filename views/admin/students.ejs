<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Students Directory</h1>
                    <p class="hero-sub-title">Manage student enrollments, academic profiles, and attendance standings</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#addStudentModal">
                        <i class="bi bi-person-plus-fill me-2"></i>+ Add New Student
                    </button>
                </div>
            </div>

            <!-- SEARCH & FILTERS CARD -->
            <div class="aesthetic-white-card mb-4 p-3">
                <form action="/admin/students" method="GET" class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="input-container">
                            <i class="bi bi-search input-icon"></i>
                            <input
                                type="text"
                                name="q"
                                class="form-control pill-input"
                                placeholder="Search by name, roll number, email..."
                                value="<%= filters.q %>"
                            >
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <select name="dept" class="form-select pill-input" onchange="this.form.submit()">
                            <option value="">All Departments</option>
                            <% departments.forEach(d => { %>
                                <option value="<%= d.id %>" <%= filters.dept == d.id ? 'selected' : '' %>>
                                    <%= d.code %> - <%= d.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select name="class_id" class="form-select pill-input" onchange="this.form.submit()">
                            <option value="">All Classes</option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= filters.class_id == c.id ? 'selected' : '' %>>
                                    <%= c.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-navy-pill w-100 justify-content-center">Filter</button>
                        <% if (filters.q || filters.dept || filters.class_id) { %>
                            <a href="/admin/students" class="btn btn-outline-secondary rounded-pill px-3" title="Clear Filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- STUDENTS TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Enrolled Students (<%= students.length %>)</h2>
                    <span class="badge-status-lime">Active Database</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Roll Number</th>
                                <th>Department & Class</th>
                                <th>Attendance %</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (students && students.length > 0) { %>
                                <% students.forEach(s => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle" style="width: 34px; height: 34px; font-size: 13px;">
                                                <%= s.full_name ? s.full_name.charAt(0).toUpperCase() : 'S' %>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark"><%= s.full_name %></div>
                                                <small class="text-muted"><%= s.email %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code><%= s.roll_number %></code></td>
                                    <td>
                                        <span class="badge-pill-soft"><%= s.dept_code %></span>
                                        <span class="text-muted ms-1"><%= s.class_name || 'Unassigned' %></span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress aesthetic-progress flex-grow-1" style="width: 80px; height: 6px;">
                                                <div class="progress-bar <%= s.pct >= 75 ? 'bg-lime-glow' : 'bg-danger' %>" style="width: <%= s.pct %>%;"></div>
                                            </div>
                                            <span class="fw-bold fs-13 <%= s.pct < 75 ? 'text-danger' : 'text-dark' %>"><%= s.pct %>%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <form action="/admin/students/<%= s.student_id %>/toggle" method="POST" style="display:inline;">
                                            <button type="submit" class="border-0 bg-transparent p-0" title="Click to toggle active status">
                                                <% if (s.is_active) { %>
                                                    <span class="badge-status-lime">Active</span>
                                                <% } else { %>
                                                    <span class="badge-status-danger">Inactive</span>
                                                <% } %>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary rounded-pill me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editStudentModal<%= s.student_id %>"
                                            title="Edit Student"
                                        >
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form action="/admin/students/<%= s.student_id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete student <%= s.full_name %>?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete Student">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- EDIT MODAL FOR EACH STUDENT -->
                                <div class="modal fade" id="editStudentModal<%= s.student_id %>" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content aesthetic-white-card p-4 border-0">
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                                                <h3 class="card-section-title mb-0">Edit Student</h3>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form action="/admin/students/<%= s.student_id %>/edit" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Full Name</label>
                                                    <input type="text" name="full_name" class="form-control pill-input" value="<%= s.full_name %>" required>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Roll Number</label>
                                                        <input type="text" name="roll_number" class="form-control pill-input" value="<%= s.roll_number %>" required>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Phone</label>
                                                        <input type="text" name="phone" class="form-control pill-input" value="<%= s.phone || '' %>">
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Email Address</label>
                                                    <input type="email" name="email" class="form-control pill-input" value="<%= s.email %>" required>
                                                </div>
                                                <div class="row g-2 mb-4">
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Department</label>
                                                        <select name="department_id" class="form-select pill-input" required>
                                                            <% departments.forEach(d => { %>
                                                                <option value="<%= d.id %>" <%= s.department_id == d.id ? 'selected' : '' %>>
                                                                    <%= d.code %> - <%= d.name %>
                                                                </option>
                                                            <% }) %>
                                                        </select>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Assigned Class</label>
                                                        <select name="class_id" class="form-select pill-input">
                                                            <option value="">Unassigned</option>
                                                            <% classes.forEach(c => { %>
                                                                <option value="<%= c.id %>" <%= s.class_id == c.id ? 'selected' : '' %>>
                                                                    <%= c.name %>
                                                                </option>
                                                            <% }) %>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-navy-pill">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-people fs-2 d-block mb-2 text-muted opacity-50"></i>
                                        No students found matching your criteria.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- PAGINATION -->
                <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-3 border-top-subtle">
                        <div class="text-muted fs-13">
                            Showing Page <strong><%= pagination.page %></strong> of <strong><%= pagination.totalPages %></strong> (<%= pagination.totalCount %> total students)
                        </div>
                        <nav aria-label="Students pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= pagination.page - 1 %>&dept=<%= filters.dept %>&class_id=<%= filters.class_id %>&q=<%= filters.q %>">
                                        <i class="bi bi-chevron-left me-1"></i>Prev
                                    </a>
                                </li>
                                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                                    <% if (p === 1 || p === pagination.totalPages || (p >= pagination.page - 2 && p <= pagination.page + 2)) { %>
                                        <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= p %>&dept=<%= filters.dept %>&class_id=<%= filters.class_id %>&q=<%= filters.q %>"><%= p %></a>
                                        </li>
                                    <% } else if (p === pagination.page - 3 || p === pagination.page + 3) { %>
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    <% } %>
                                <% } %>
                                <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="?page=<%= pagination.page + 1 %>&dept=<%= filters.dept %>&class_id=<%= filters.class_id %>&q=<%= filters.q %>">
                                        Next<i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

<!-- ADD STUDENT MODAL -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Add New Student</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/students/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Full Name *</label>
                    <input type="text" name="full_name" class="form-control pill-input" placeholder="e.g. Ramesh Kumar" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Roll Number *</label>
                        <input type="text" name="roll_number" class="form-control pill-input" placeholder="e.g. CS2024007" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Phone Number</label>
                        <input type="text" name="phone" class="form-control pill-input" placeholder="e.g. 9876543210">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Email Address *</label>
                    <input type="email" name="email" class="form-control pill-input" placeholder="e.g. ramesh@student.svce.edu" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Department *</label>
                        <select name="department_id" class="form-select pill-input" required>
                            <option value="">Select Dept</option>
                            <% departments.forEach(d => { %>
                                <option value="<%= d.id %>"><%= d.code %> - <%= d.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Class Section</label>
                        <select name="class_id" class="form-select pill-input">
                            <option value="">Unassigned</option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Initial Password</label>
                    <input type="password" name="password" class="form-control pill-input" placeholder="Default: password123">
                    <small class="text-muted">If left blank, default is <code>password123</code></small>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Register Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
