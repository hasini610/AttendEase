<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Faculty Teaching Assignments</h1>
                    <p class="hero-sub-title">Map professors and instructors to curriculum subjects and class sections</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#addAssignmentModal">
                        <i class="bi bi-person-plus-fill me-2"></i>+ Assign Faculty
                    </button>
                </div>
            </div>

            <!-- FILTERS CARD -->
            <div class="aesthetic-white-card mb-4 p-3">
                <form action="/admin/assignments" method="GET" class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <select name="dept" class="form-select pill-input" onchange="this.form.submit()">
                            <option value="">All Departments</option>
                            <% departments.forEach(d => { %>
                                <option value="<%= d.id %>" <%= filters.dept == d.id ? 'selected' : '' %>>
                                    <%= d.code %> - <%= d.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-12 col-md-5">
                        <select name="class_id" class="form-select pill-input" onchange="this.form.submit()">
                            <option value="">All Class Sections</option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= filters.class_id == c.id ? 'selected' : '' %>>
                                    <%= c.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-navy-pill w-100 justify-content-center">Filter</button>
                        <% if (filters.dept || filters.class_id) { %>
                            <a href="/admin/assignments" class="btn btn-outline-secondary rounded-pill px-3" title="Clear Filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- ASSIGNMENTS TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Active Teaching Allocations (<%= assignments.length %>)</h2>
                    <span class="badge-status-lime">Curriculum Mapping</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Faculty Member</th>
                                <th>Subject</th>
                                <th>Class Section</th>
                                <th>Department</th>
                                <th>Timetable Slots</th>
                                <th>Sessions Taken</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (assignments && assignments.length > 0) { %>
                                <% assignments.forEach(a => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-circle-sm">
                                                <%= a.faculty_name.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark fs-14"><%= a.faculty_name %></div>
                                                <div class="text-muted fs-12"><code><%= a.employee_id %></code></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <span class="badge-pill-soft me-1"><%= a.subject_code %></span>
                                            <span class="fw-semibold text-dark"><%= a.subject_name %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 fw-bold">
                                            <%= a.class_name %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark"><%= a.dept_code %></span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark"><%= a.timetable_slots_count %></span> slots / week
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark"><%= a.conducted_sessions_count %></span> sessions
                                    </td>
                                    <td class="text-end">
                                        <form action="/admin/assignments/<%= a.assignment_id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Remove assignment of <%= a.subject_code %> for <%= a.faculty_name %>?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Unassign Faculty">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-person-lines-fill fs-2 d-block mb-2 text-muted opacity-50"></i>
                                        No faculty assignments found matching the filter criteria.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ADD ASSIGNMENT MODAL -->
<div class="modal fade" id="addAssignmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Assign Faculty to Subject</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/assignments/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Faculty Member *</label>
                    <select name="faculty_id" class="form-select pill-input" required>
                        <option value="">Select Faculty</option>
                        <% facultyList.forEach(f => { %>
                            <option value="<%= f.id %>">
                                <%= f.full_name %> (<%= f.employee_id %> - <%= f.dept_code %>)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Subject / Course *</label>
                    <select name="subject_id" class="form-select pill-input" required>
                        <option value="">Select Subject</option>
                        <% subjects.forEach(s => { %>
                            <option value="<%= s.id %>">
                                [<%= s.code %>] <%= s.name %> (<%= s.dept_code %>)
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Class Section *</label>
                    <select name="class_id" class="form-select pill-input" required>
                        <option value="">Select Class Section</option>
                        <% classes.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Create Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
