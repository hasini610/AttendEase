<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Course Curriculum & Subjects</h1>
                    <p class="hero-sub-title">Configure subject codes, syllabus titles, department mappings, and credit points</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#addSubjectModal">
                        <i class="bi bi-book-fill me-2"></i>+ Add Subject
                    </button>
                </div>
            </div>

            <!-- SUBJECTS TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Active Subjects (<%= subjects.length %>)</h2>
                    <span class="badge-status-lime">Curriculum</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Subject Title</th>
                                <th>Course Code</th>
                                <th>Department</th>
                                <th>Credits</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (subjects && subjects.length > 0) { %>
                                <% subjects.forEach(sub => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14"><%= sub.name %></div>
                                    </td>
                                    <td><span class="badge-pill-soft"><%= sub.code %></span></td>
                                    <td><span class="fw-semibold text-dark"><%= sub.dept_code %></span> - <%= sub.department_name %></td>
                                    <td><span class="badge bg-secondary-subtle text-secondary rounded-pill px-3"><%= sub.credits %> Credits</span></td>
                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary rounded-pill me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editSubjectModal<%= sub.id %>"
                                            title="Edit Subject"
                                        >
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <form action="/admin/subjects/<%= sub.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete subject <%= sub.name %>?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" title="Delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <!-- EDIT MODAL -->
                                <div class="modal fade" id="editSubjectModal<%= sub.id %>" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content aesthetic-white-card p-4 border-0">
                                            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                                                <h3 class="card-section-title mb-0">Edit Subject</h3>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <form action="/admin/subjects/<%= sub.id %>/edit" method="POST">
                                                <div class="mb-3">
                                                    <label class="form-label fs-13 fw-semibold">Subject Title *</label>
                                                    <input type="text" name="name" class="form-control pill-input" value="<%= sub.name %>" required>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Course Code *</label>
                                                        <input type="text" name="code" class="form-control pill-input" value="<%= sub.code %>" required>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label fs-13 fw-semibold">Credits</label>
                                                        <input type="number" name="credits" class="form-control pill-input" value="<%= sub.credits %>" min="1" max="10">
                                                    </div>
                                                </div>
                                                <div class="mb-4">
                                                    <label class="form-label fs-13 fw-semibold">Department *</label>
                                                    <select name="department_id" class="form-select pill-input" required>
                                                        <% departments.forEach(d => { %>
                                                            <option value="<%= d.id %>" <%= sub.department_id == d.id ? 'selected' : '' %>>
                                                                <%= d.code %> - <%= d.name %>
                                                            </option>
                                                        <% }) %>
                                                    </select>
                                                </div>
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-navy-pill">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">No subjects registered yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ADD SUBJECT MODAL -->
<div class="modal fade" id="addSubjectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Add Subject</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/subjects/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Subject Title *</label>
                    <input type="text" name="name" class="form-control pill-input" placeholder="e.g. Artificial Intelligence" required>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Course Code *</label>
                        <input type="text" name="code" class="form-control pill-input" placeholder="e.g. CS401" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Credits</label>
                        <input type="number" name="credits" class="form-control pill-input" value="3" min="1" max="10">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Department *</label>
                    <select name="department_id" class="form-select pill-input" required>
                        <option value="">Select Dept</option>
                        <% departments.forEach(d => { %>
                            <option value="<%= d.id %>"><%= d.code %> - <%= d.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Create Subject</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
