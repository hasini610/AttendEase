<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Profile & Security</h1>
                    <p class="hero-sub-title">Manage your personal credentials, contact info, and account security</p>
                </div>
                <div class="hero-action-box">
                    <a href="/<%= user.role %>/dashboard" class="btn btn-navy-pill">
                        <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
            </div>

            <div class="row g-4">
                <!-- LEFT COLUMN: Profile Overview Card -->
                <div class="col-12 col-lg-4">
                    <div class="aesthetic-white-card text-center mb-4">
                        <div class="avatar-circle mx-auto mb-3" style="width: 72px; height: 72px; font-size: 28px; background: #f7d794;">
                            <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <h2 class="fs-18 fw-800 text-dark mb-1"><%= user.full_name %></h2>
                        <span class="badge-pill-soft text-capitalize mb-3 d-inline-block">
                            <i class="bi bi-shield-check me-1"></i><%= user.role %>
                        </span>

                        <div class="border-top-subtle pt-3 mt-2 text-start">
                            <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                <span class="text-muted fs-13">Username</span>
                                <span class="fw-bold fs-13 text-dark"><%= user.username %></span>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                <span class="text-muted fs-13">Email</span>
                                <span class="fw-bold fs-13 text-dark"><%= user.email %></span>
                            </div>
                            <% if (user.role === 'student' && roleDetails) { %>
                                <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                    <span class="text-muted fs-13">Roll Number</span>
                                    <span class="fw-bold fs-13 text-dark"><code><%= roleDetails.roll_number %></code></span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                    <span class="text-muted fs-13">Department</span>
                                    <span class="fw-bold fs-13 text-dark"><%= roleDetails.department_name %> (<%= roleDetails.dept_code %>)</span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                    <span class="text-muted fs-13">Class</span>
                                    <span class="fw-bold fs-13 text-dark"><%= roleDetails.class_name || 'N/A' %></span>
                                </div>
                            <% } else if (user.role === 'faculty' && roleDetails) { %>
                                <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                    <span class="text-muted fs-13">Employee ID</span>
                                    <span class="fw-bold fs-13 text-dark"><code><%= roleDetails.employee_id %></code></span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                    <span class="text-muted fs-13">Department</span>
                                    <span class="fw-bold fs-13 text-dark"><%= roleDetails.department_name %></span>
                                </div>
                                <div class="d-flex justify-content-between py-2 border-bottom-subtle">
                                    <span class="text-muted fs-13">Designation</span>
                                    <span class="fw-bold fs-13 text-dark"><%= roleDetails.designation || 'Lecturer' %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN: Update Forms -->
                <div class="col-12 col-lg-8">
                    <!-- 1. Personal Details Form -->
                    <div class="aesthetic-white-card mb-4">
                        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom-subtle">
                            <h2 class="card-section-title mb-0">Personal Details</h2>
                            <span class="badge-pill-soft">Account Info</span>
                        </div>

                        <form action="/<%= user.role %>/profile/update" method="POST">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fs-13 fw-semibold">Full Name</label>
                                    <input type="text" name="full_name" class="form-control pill-input" value="<%= user.full_name %>" required>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fs-13 fw-semibold">Phone Number</label>
                                    <input type="text" name="phone" class="form-control pill-input" placeholder="e.g. 9876543210" value="<%= user.phone || '' %>">
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fs-13 fw-semibold">Email Address</label>
                                    <input type="email" class="form-control pill-input" value="<%= user.email %>" disabled>
                                    <small class="text-muted">Contact admin to change email</small>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fs-13 fw-semibold">Username</label>
                                    <input type="text" class="form-control pill-input" value="<%= user.username %>" disabled>
                                </div>
                            </div>
                            <div class="mt-4 text-end">
                                <button type="submit" class="btn btn-navy-pill">
                                    <i class="bi bi-check2-circle me-1"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- 2. Change Password Form -->
                    <div class="aesthetic-white-card">
                        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom-subtle">
                            <h2 class="card-section-title mb-0">Security & Password</h2>
                            <span class="badge-status-lime">Encrypted (bcrypt)</span>
                        </div>

                        <form action="/<%= user.role %>/profile/change-password" method="POST">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fs-13 fw-semibold">Current Password</label>
                                    <div class="input-container">
                                        <i class="bi bi-shield-lock input-icon"></i>
                                        <input type="password" name="current_password" class="form-control pill-input has-toggle" placeholder="Enter your current password" required>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fs-13 fw-semibold">New Password</label>
                                    <div class="input-container">
                                        <i class="bi bi-key input-icon"></i>
                                        <input type="password" name="new_password" class="form-control pill-input has-toggle" placeholder="At least 6 characters" minlength="6" required>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fs-13 fw-semibold">Confirm New Password</label>
                                    <div class="input-container">
                                        <i class="bi bi-key-fill input-icon"></i>
                                        <input type="password" name="confirm_password" class="form-control pill-input has-toggle" placeholder="Re-type new password" minlength="6" required>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4 text-end">
                                <button type="submit" class="btn btn-navy-pill">
                                    <i class="bi bi-lock-fill me-1"></i> Update Password
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
