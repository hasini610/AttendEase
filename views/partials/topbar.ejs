<%# views/partials/topbar.ejs
    Modern Top Bar matching the screenshot
    Required: user, pageTitle, notifCount %>

<header class="aesthetic-topbar">
    <div class="topbar-left d-flex align-items-center gap-3">
        <!-- Mobile rail toggler -->
        <button class="rail-toggler d-lg-none" id="hamburger" title="Toggle Navigation">
            <i class="bi bi-list"></i>
        </button>

        <!-- Brand Name & Institution -->
        <div class="brand-text d-flex align-items-center gap-2">
            <span class="brand-title-text">AttendEase</span>
            <span class="text-white-50 d-none d-md-inline">&bull;</span>
            <span class="text-white-50 fs-12 fw-500 d-none d-md-inline"><%= collegeName %></span>
        </div>
    </div>

    <div class="topbar-right d-flex align-items-center gap-3">
        <!-- User Profile Pill / Dropdown -->
        <div class="dropdown">
            <button class="user-avatar-pill" data-bs-toggle="dropdown" aria-expanded="false" title="User Menu">
                <div class="avatar-circle">
                    <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : 'U' %>
                </div>
            </button>
            <ul class="dropdown-menu dropdown-menu-end custom-dropdown shadow-lg border-0">
                <li class="dropdown-header-box">
                    <div class="fw-bold text-dark"><%= user.full_name %></div>
                    <div class="user-badge-role text-capitalize"><%= user.role %> &bull; <%= user.username %></div>
                    <div class="text-muted fs-11 mt-1"><%= collegeName %></div>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item" href="/<%= user.role %>/profile">
                        <i class="bi bi-person me-2"></i>Profile Settings
                    </a>
                </li>
                <li>
                    <a class="dropdown-item text-danger" href="/logout">
                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>
