<%# views/partials/sidebar.ejs
    Modern Icon Rail Sidebar inspired by screenshot
    Required variables: user (session user object), activePage (string) %>

<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside class="sidebar-rail" id="sidebar">
    <!-- Brand Glyph -->
    <a href="/<%= user.role %>/dashboard" class="rail-brand" title="AttendEase Home">
        <div class="rail-glyph">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <ellipse cx="12" cy="12" rx="4" ry="10"></ellipse>
            </svg>
        </div>
    </a>

    <!-- Navigation Icon Pills -->
    <nav class="rail-nav">
        <% if (user.role === 'admin') { %>
            <a href="/admin/dashboard" class="rail-link <%= activePage === 'dashboard' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                <i class="bi bi-grid-fill"></i>
                <span class="rail-label">Dashboard</span>
            </a>
            <a href="/admin/students" class="rail-link <%= activePage === 'students' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Students">
                <i class="bi bi-people-fill"></i>
                <span class="rail-label">Students</span>
            </a>
            <a href="/admin/faculty" class="rail-link <%= activePage === 'faculty' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Faculty">
                <i class="bi bi-person-badge-fill"></i>
                <span class="rail-label">Faculty</span>
            </a>
            <a href="/admin/departments" class="rail-link <%= activePage === 'departments' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Departments">
                <i class="bi bi-building"></i>
                <span class="rail-label">Departments</span>
            </a>
            <a href="/admin/classes" class="rail-link <%= activePage === 'classes' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Classes / Sections">
                <i class="bi bi-diagram-3-fill"></i>
                <span class="rail-label">Classes</span>
            </a>
            <a href="/admin/subjects" class="rail-link <%= activePage === 'subjects' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Subjects">
                <i class="bi bi-book-fill"></i>
                <span class="rail-label">Subjects</span>
            </a>
            <a href="/admin/assignments" class="rail-link <%= activePage === 'assignments' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Faculty Assignments">
                <i class="bi bi-person-lines-fill"></i>
                <span class="rail-label">Assignments</span>
            </a>
            <a href="/admin/timetable" class="rail-link <%= activePage === 'timetable' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Master Timetable">
                <i class="bi bi-calendar3"></i>
                <span class="rail-label">Timetable</span>
            </a>
            <a href="/admin/reports" class="rail-link <%= activePage === 'reports' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Analytics & Reports">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span class="rail-label">Reports</span>
            </a>
            <a href="/admin/profile" class="rail-link <%= activePage === 'profile' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Settings / Profile">
                <i class="bi bi-gear-fill"></i>
                <span class="rail-label">Profile</span>
            </a>

        <% } else if (user.role === 'faculty') { %>
            <a href="/faculty/dashboard" class="rail-link <%= activePage === 'dashboard' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                <i class="bi bi-grid-fill"></i>
                <span class="rail-label">Dashboard</span>
            </a>
            <a href="/faculty/timetable" class="rail-link <%= activePage === 'timetable' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="My Timetable">
                <i class="bi bi-calendar3"></i>
                <span class="rail-label">Timetable</span>
            </a>
            <a href="/faculty/sessions" class="rail-link <%= activePage === 'sessions' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Class Sessions">
                <i class="bi bi-collection-play-fill"></i>
                <span class="rail-label">Sessions</span>
            </a>
            <a href="/faculty/mark" class="rail-link <%= activePage === 'mark' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Mark Attendance">
                <i class="bi bi-calendar-check-fill"></i>
                <span class="rail-label">Mark Attendance</span>
            </a>
            <a href="/faculty/history" class="rail-link <%= activePage === 'history' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Attendance History">
                <i class="bi bi-clock-history"></i>
                <span class="rail-label">History</span>
            </a>
            <a href="/faculty/reports" class="rail-link <%= activePage === 'reports' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Class Reports">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span class="rail-label">Reports</span>
            </a>
            <a href="/faculty/profile" class="rail-link <%= activePage === 'profile' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Settings / Profile">
                <i class="bi bi-gear-fill"></i>
                <span class="rail-label">Profile</span>
            </a>

        <% } else if (user.role === 'student') { %>
            <a href="/student/dashboard" class="rail-link <%= activePage === 'dashboard' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                <i class="bi bi-grid-fill"></i>
                <span class="rail-label">Dashboard</span>
            </a>
            <a href="/student/timetable" class="rail-link <%= activePage === 'timetable' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="My Timetable">
                <i class="bi bi-calendar3"></i>
                <span class="rail-label">Timetable</span>
            </a>
            <a href="/student/attendance" class="rail-link <%= activePage === 'attendance' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="My Attendance">
                <i class="bi bi-calendar-check-fill"></i>
                <span class="rail-label">My Attendance</span>
            </a>
            <a href="/student/history" class="rail-link <%= activePage === 'history' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Attendance History">
                <i class="bi bi-clock-history"></i>
                <span class="rail-label">History</span>
            </a>
            <a href="/student/profile" class="rail-link <%= activePage === 'profile' ? 'active' : '' %>" data-bs-toggle="tooltip" data-bs-placement="right" title="Settings / Profile">
                <i class="bi bi-gear-fill"></i>
                <span class="rail-label">Profile</span>
            </a>
        <% } %>
    </nav>

    <!-- Bottom Logout -->
    <div class="rail-footer">
        <a href="/logout" class="rail-link rail-logout" data-bs-toggle="tooltip" data-bs-placement="right" title="Sign Out">
            <i class="bi bi-box-arrow-left"></i>
            <span class="rail-label">Sign Out</span>
        </a>
    </div>
</aside>
