<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        .status-pill-toggle input[type="radio"] {
            display: none;
        }
        .status-pill-toggle label {
            cursor: pointer;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 600;
            border-radius: 50px;
            border: 1px solid #e2e8f0;
            color: #64748b;
            background: #ffffff;
            transition: all 0.15s ease-in-out;
            user-select: none;
        }
        .status-pill-toggle input[value="present"]:checked + label {
            background-color: #22c55e;
            color: #ffffff;
            border-color: #22c55e;
            box-shadow: 0 2px 6px rgba(34, 197, 94, 0.35);
        }
        .status-pill-toggle input[value="late"]:checked + label {
            background-color: #eab308;
            color: #ffffff;
            border-color: #eab308;
            box-shadow: 0 2px 6px rgba(234, 179, 8, 0.35);
        }
        .status-pill-toggle input[value="absent"]:checked + label {
            background-color: #ef4444;
            color: #ffffff;
            border-color: #ef4444;
            box-shadow: 0 2px 6px rgba(239, 68, 68, 0.35);
        }
    </style>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER WITH SESSION CONTEXT -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 border shadow-xs fs-13">
                            <%= sessionData.class_name %>
                        </span>
                        <span class="badge-pill-soft fs-13">
                            <%= sessionData.subject_code %> &mdash; <%= sessionData.subject_name %>
                        </span>
                    </div>
                    <h1 class="hero-main-title">
                        Roll Call: <%= formatDate(sessionData.session_date) %> &bull; Period #<%= sessionData.session_number %>
                    </h1>
                    <p class="hero-sub-title mb-0">
                        Topic: <strong><%= sessionData.topic || 'Regular Curriculum Class' %></strong> &bull; Total Students: <strong><%= students.length %></strong>
                    </p>
                </div>

                <div class="hero-action-box d-flex align-items-center gap-2">
                    <a href="/faculty/sessions" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Back to Sessions
                    </a>
                </div>
            </div>

            <!-- BULK ACTIONS & LIVE STATS CARD -->
            <div class="aesthetic-white-card mb-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fs-13 fw-semibold text-muted">Bulk Selection:</span>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="setAllStatus('present')">
                        <i class="bi bi-check-all me-1"></i> Mark All Present
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="setAllStatus('late')">
                        <i class="bi bi-clock me-1"></i> Mark All Late
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="setAllStatus('absent')">
                        <i class="bi bi-x-circle me-1"></i> Mark All Absent
                    </button>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fs-13 fw-semibold" id="counterPresent">
                        0 Present
                    </span>
                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-2 fs-13 fw-semibold" id="counterLate">
                        0 Late
                    </span>
                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 fs-13 fw-semibold" id="counterAbsent">
                        0 Absent
                    </span>
                </div>
            </div>

            <!-- ATTENDANCE ROSTER FORM -->
            <form action="/faculty/mark/<%= sessionData.id %>" method="POST" id="attendanceForm">
                <div class="aesthetic-white-card">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                        <h2 class="card-section-title mb-0">Enrolled Student Roster (<%= students.length %>)</h2>
                        <span class="badge-status-lime">Enrolled Section</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table aesthetic-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Roll Number</th>
                                    <th>Student Name</th>
                                    <th>Email</th>
                                    <th class="text-end" style="min-width: 260px;">Attendance Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach((stu, idx) => { %>
                                    <%
                                        // Default status: existing status, or default to 'present' for convenient marking
                                        const status = stu.current_status || 'present';
                                    %>
                                    <tr>
                                        <td class="text-muted fs-12"><%= idx + 1 %></td>
                                        <td>
                                            <code><%= stu.roll_number %></code>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark"><%= stu.full_name %></div>
                                        </td>
                                        <td>
                                            <span class="text-muted fs-13"><%= stu.email %></span>
                                        </td>
                                        <td class="text-end">
                                            <div class="status-pill-toggle d-inline-flex gap-1" data-student="<%= stu.student_id %>">
                                                <input
                                                    type="radio"
                                                    id="present_<%= stu.student_id %>"
                                                    name="attendance[s_<%= stu.student_id %>]"
                                                    value="present"
                                                    <%= status === 'present' ? 'checked' : '' %>
                                                    onchange="updateCounters()"
                                                >
                                                <label for="present_<%= stu.student_id %>">
                                                    <i class="bi bi-check me-1"></i>Present
                                                </label>

                                                <input
                                                    type="radio"
                                                    id="late_<%= stu.student_id %>"
                                                    name="attendance[s_<%= stu.student_id %>]"
                                                    value="late"
                                                    <%= status === 'late' ? 'checked' : '' %>
                                                    onchange="updateCounters()"
                                                >
                                                <label for="late_<%= stu.student_id %>">
                                                    <i class="bi bi-clock me-1"></i>Late
                                                </label>

                                                <input
                                                    type="radio"
                                                    id="absent_<%= stu.student_id %>"
                                                    name="attendance[s_<%= stu.student_id %>]"
                                                    value="absent"
                                                    <%= status === 'absent' ? 'checked' : '' %>
                                                    onchange="updateCounters()"
                                                >
                                                <label for="absent_<%= stu.student_id %>">
                                                    <i class="bi bi-x me-1"></i>Absent
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            No students enrolled in this section.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- SUBMIT BAR -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top-subtle">
                        <span class="text-muted fs-13">
                            <i class="bi bi-shield-check text-success me-1"></i> All updates are recorded atomically with audit timestamps.
                        </span>
                        <div class="d-flex gap-2">
                            <a href="/faculty/sessions" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-navy-pill px-5">
                                <i class="bi bi-save me-1"></i> Save Attendance
                            </button>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

<script>
function setAllStatus(status) {
    const inputs = document.querySelectorAll(`input[type="radio"][value="${status}"]`);
    inputs.forEach(input => {
        input.checked = true;
    });
    updateCounters();
}

function updateCounters() {
    const presents = document.querySelectorAll('input[type="radio"][value="present"]:checked').length;
    const lates    = document.querySelectorAll('input[type="radio"][value="late"]:checked').length;
    const absents  = document.querySelectorAll('input[type="radio"][value="absent"]:checked').length;

    document.getElementById('counterPresent').textContent = `${presents} Present`;
    document.getElementById('counterLate').textContent    = `${lates} Late`;
    document.getElementById('counterAbsent').textContent  = `${absents} Absent`;
}

document.addEventListener('DOMContentLoaded', function() {
    updateCounters();
});
</script>

</body>
</html>
