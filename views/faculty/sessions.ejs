<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Class Lecture Sessions</h1>
                    <p class="hero-sub-title">Schedule lecture dates, log syllabus topics, and manage attendance sessions</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#createSessionModal">
                        <i class="bi bi-plus-circle-fill me-2"></i>+ Schedule New Session
                    </button>
                </div>
            </div>

            <!-- FILTERS CARD -->
            <div class="aesthetic-white-card mb-4 p-3">
                <form action="/faculty/sessions" method="GET" class="row g-2 align-items-center">
                    <div class="col-12 col-md-10">
                        <select name="assignment_id" class="form-select pill-input" onchange="this.form.submit()">
                            <option value="">All Assigned Subjects & Classes</option>
                            <% assignments.forEach(a => { %>
                                <option value="<%= a.id %>" <%= filters.assignment_id == a.id ? 'selected' : '' %>>
                                    [<%= a.code %>] <%= a.subject_name %> &mdash; <%= a.class_name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-navy-pill w-100 justify-content-center">Filter</button>
                        <% if (filters.assignment_id) { %>
                            <a href="/faculty/sessions" class="btn btn-outline-secondary rounded-pill px-3" title="Clear Filter">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- SESSIONS TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Recorded Lecture Sessions (<%= sessions.length %>)</h2>
                    <span class="badge-status-lime">Curriculum Ledger</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date & Period</th>
                                <th>Class & Section</th>
                                <th>Subject</th>
                                <th>Syllabus Topic</th>
                                <th>Attendance Breakdown</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (sessions && sessions.length > 0) { %>
                                <% sessions.forEach(sess => { %>
                                <%
                                    const total = Number(sess.total_marked) || 0;
                                    const attended = (Number(sess.present_count) || 0) + (Number(sess.late_count) || 0);
                                    const pct = total > 0 ? Math.round((attended / total) * 100) : 0;
                                %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14">
                                            <%= formatDate(sess.session_date) %>
                                        </div>
                                        <span class="badge bg-light text-dark border rounded-pill px-2 fs-11">
                                            Period #<%= sess.session_number %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge-pill-soft fw-bold"><%= sess.class_name %></span>
                                    </td>
                                    <td>
                                        <div>
                                            <span class="badge-pill-soft me-1"><%= sess.subject_code %></span>
                                            <span class="fw-semibold text-dark"><%= sess.subject_name %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-dark fs-13"><%= sess.topic || 'Regular Lecture' %></div>
                                    </td>
                                    <td>
                                        <% if (total > 0) { %>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height:6px; min-width:60px;">
                                                    <div class="progress-bar <%= pct >= 75 ? 'bg-success' : 'bg-danger' %>" style="width: <%= pct %>%"></div>
                                                </div>
                                                <span class="fw-bold fs-12 <%= pct >= 75 ? 'text-success' : 'text-danger' %>"><%= pct %>%</span>
                                            </div>
                                            <small class="text-muted fs-11"><%= sess.present_count || 0 %>P &bull; <%= sess.late_count || 0 %>L &bull; <%= sess.absent_count || 0 %>A</small>
                                        <% } else { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3">Unmarked</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <a href="/faculty/mark/<%= sess.id %>" class="btn btn-navy-pill btn-sm px-3 me-1">
                                            <i class="bi bi-pencil-square me-1"></i><%= total > 0 ? 'Edit' : 'Mark' %>
                                        </a>
                                        <% if (total > 0) { %>
                                            <a href="/faculty/history/<%= sess.id %>" class="btn btn-sm btn-outline-secondary rounded-pill" title="View Roster">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-journal-x fs-2 d-block mb-2 text-muted opacity-50"></i>
                                        No class sessions recorded yet. Click "+ Schedule New Session" above to create one.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- CREATE SESSION MODAL -->
<div class="modal fade" id="createSessionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Schedule Class Session</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/faculty/sessions/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Class & Subject Allocation *</label>
                    <select name="assignment_id" class="form-select pill-input" required>
                        <option value="">Select Class & Subject</option>
                        <% assignments.forEach(a => { %>
                            <option value="<%= a.id %>">
                                <%= a.class_name %> &mdash; [<%= a.code %>] <%= a.subject_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Session Date *</label>
                        <input
                            type="date"
                            name="session_date"
                            class="form-control pill-input"
                            value="<%= formatDate(new Date()) %>"
                            required
                        >
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Period / Slot # *</label>
                        <select name="session_number" class="form-select pill-input" required>
                            <option value="1">Period 1</option>
                            <option value="2">Period 2</option>
                            <option value="3">Period 3</option>
                            <option value="4">Period 4</option>
                            <option value="5">Period 5</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Lecture Topic / Notes</label>
                    <input
                        type="text"
                        name="topic"
                        class="form-control pill-input"
                        placeholder="e.g. Unit 3: Normalization & BCNF"
                    >
                    <small class="text-muted">Optional topic description covered during this class.</small>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Create & Mark Attendance</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
