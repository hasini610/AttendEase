<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Mark Student Attendance</h1>
                    <p class="hero-sub-title">Select a lecture session to take roll call or schedule a new lecture period</p>
                </div>
                <div class="hero-action-box">
                    <button type="button" class="btn btn-navy-pill" data-bs-toggle="modal" data-bs-target="#newSessionModal">
                        <i class="bi bi-plus-circle-fill me-2"></i>+ Start New Session
                    </button>
                </div>
            </div>

            <!-- AVAILABLE SESSIONS TABLE CARD -->
            <div class="aesthetic-white-card mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <div>
                        <h2 class="card-section-title mb-0">Select Lecture Session</h2>
                        <small class="text-muted">Choose any recent or pending session to record student presence</small>
                    </div>
                    <span class="badge-status-lime">Active Sessions</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date & Period</th>
                                <th>Class & Section</th>
                                <th>Subject</th>
                                <th>Topic</th>
                                <th>Roster Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (availableSessions && availableSessions.length > 0) { %>
                                <% availableSessions.forEach(sess => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14">
                                            <%= formatDate(sess.session_date) %>
                                        </div>
                                        <span class="badge bg-light text-dark border rounded-pill px-2 fs-11">
                                            Period #<%= sess.session_number %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge-pill-soft fw-bold"><%= sess.class_name %></span>
                                    </td>
                                    <td>
                                        <span class="badge-pill-soft me-1"><%= sess.subject_code %></span>
                                        <span class="fw-semibold text-dark"><%= sess.subject_name %></span>
                                    </td>
                                    <td>
                                        <span class="text-muted fs-13"><%= sess.topic || 'Regular Lecture' %></span>
                                    </td>
                                    <td>
                                        <% if (sess.marked_count > 0) { %>
                                            <span class="badge-status-lime">Marked (<%= sess.marked_count %>/<%= sess.enrolled_count %>)</span>
                                        <% } else { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3">Pending (<%= sess.enrolled_count %> students)</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <a href="/faculty/mark/<%= sess.id %>" class="btn btn-navy-pill btn-sm px-4">
                                            <i class="bi bi-pencil-square me-1"></i><%= sess.marked_count > 0 ? 'Edit Register' : 'Take Attendance' %>
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-check fs-2 d-block mb-2 text-muted opacity-50"></i>
                                        No recent sessions available. Click "+ Start New Session" to create one.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- NEW SESSION MODAL -->
<div class="modal fade" id="newSessionModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content aesthetic-white-card p-4 border-0">
            <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom-subtle">
                <h3 class="card-section-title mb-0">+ Start Attendance Session</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/faculty/sessions/create" method="POST">
                <div class="mb-3">
                    <label class="form-label fs-13 fw-semibold">Class & Subject Allocation *</label>
                    <select name="assignment_id" class="form-select pill-input" required>
                        <option value="">Select Class & Subject</option>
                        <% assignments.forEach(a => { %>
                            <option value="<%= a.id %>">
                                <%= a.class_name %> &mdash; [<%= a.code %>] <%= a.subject_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Session Date *</label>
                        <input
                            type="date"
                            name="session_date"
                            class="form-control pill-input"
                            value="<%= formatDate(new Date()) %>"
                            required
                        >
                    </div>
                    <div class="col-6">
                        <label class="form-label fs-13 fw-semibold">Period / Slot # *</label>
                        <select name="session_number" class="form-select pill-input" required>
                            <option value="1">Period 1</option>
                            <option value="2">Period 2</option>
                            <option value="3">Period 3</option>
                            <option value="4">Period 4</option>
                            <option value="5">Period 5</option>
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fs-13 fw-semibold">Topic Covered (Optional)</label>
                    <input
                        type="text"
                        name="topic"
                        class="form-control pill-input"
                        placeholder="e.g. Unit 4: Relational Algebra"
                    >
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy-pill">Proceed to Roll Call</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
