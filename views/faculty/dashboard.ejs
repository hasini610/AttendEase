<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO STATS HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Faculty Schedule & Attendance</h1>
                    <p class="hero-sub-title">Welcome back, <%= user.full_name %> &bull; <%= faculty.designation %> (<%= faculty.dept_code %>)</p>
                </div>

                <div class="hero-right-stats d-flex align-items-center gap-4">
                    <div class="hero-stat-item">
                        <div class="hero-stat-label">Assigned Classes</div>
                        <div class="hero-stat-value"><%= stats.assignedClasses || 0 %></div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-label">Sessions Taken</div>
                        <div class="hero-stat-value"><%= stats.sessionsTaken || 0 %></div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-label">Average Attendance</div>
                        <div class="hero-stat-value text-success"><%= stats.overallPct %>%</div>
                    </div>
                    <div class="hero-action-box">
                        <a href="/faculty/mark" class="btn btn-navy-pill">
                            <i class="bi bi-pencil-square me-2"></i>+ Mark Attendance
                        </a>
                    </div>
                </div>
            </div>

            <!-- MAIN 2-COLUMN LAYOUT -->
            <div class="row g-4 mb-4">
                
                <!-- LEFT COLUMN: Calendar + Today's Lectures + Quick Health -->
                <div class="col-12 col-xl-4 col-lg-5">
                    
                    <!-- 1. Mini Calendar Card -->
                    <div class="aesthetic-calendar-card mb-3">
                        <div class="calendar-card-header d-flex align-items-center justify-content-between mb-3">
                            <span class="cal-month-title" id="calMonthTitle">Calendar</span>
                            <div class="cal-nav-arrows">
                                <button type="button" class="cal-arrow-btn" onclick="prevMonth()"><i class="bi bi-chevron-left"></i></button>
                                <button type="button" class="cal-arrow-btn" onclick="nextMonth()"><i class="bi bi-chevron-right"></i></button>
                            </div>
                        </div>

                        <div class="calendar-days-row">
                            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                        </div>
                        <div class="calendar-grid-dates" id="calendarDates"></div>
                    </div>

                    <!-- 2. Today's Lectures Checklist Card -->
                    <div class="aesthetic-white-card checklist-card mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h2 class="card-section-title mb-0">Today's Lectures</h2>
                                <small class="text-muted"><%= todayDay %></small>
                            </div>
                            <span class="badge-pill-soft"><%= todayLectures.length %> Periods</span>
                        </div>
                        
                        <div class="task-checklist-list">
                            <% if (todayLectures && todayLectures.length > 0) { %>
                                <% todayLectures.forEach(l => { %>
                                <div class="p-2 mb-2 rounded border bg-light-subtle d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-bold text-dark fs-13"><%= l.subject_code %> - <%= l.class_name %></div>
                                        <div class="text-muted fs-11">
                                            <i class="bi bi-clock me-1"></i><%= l.start_time.substring(0,5) %> – <%= l.end_time.substring(0,5) %> &bull; <%= l.classroom %>
                                        </div>
                                    </div>
                                    <a href="/faculty/sessions?assignment_id=<%= l.assignment_id %>" class="btn btn-sm btn-outline-secondary rounded-pill fs-11 px-2 py-0" title="View sessions">
                                        Sessions
                                    </a>
                                </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-3 text-muted">
                                    <i class="bi bi-cup-hot fs-3 text-muted opacity-50 d-block mb-1"></i>
                                    <p class="mb-0 fs-13">No lectures scheduled for today (<%= todayDay %>).</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- 3. Class Health & Low Attendance Alerts Card -->
                    <div class="aesthetic-white-card checklist-card">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h2 class="card-section-title mb-0">Attendance Health</h2>
                            <span class="badge-status-lime">Active Monitor</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom-subtle">
                            <span class="text-muted fs-13">Total Enrolled Students</span>
                            <span class="fw-bold fs-14 text-dark"><%= stats.totalStudents || 0 %></span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom-subtle">
                            <span class="text-muted fs-13">Total Sessions Held</span>
                            <span class="fw-bold fs-14 text-dark"><%= stats.sessionsTaken || 0 %></span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2">
                            <div>
                                <span class="text-muted fs-13 d-block">Below 75% Threshold</span>
                                <small class="text-danger fs-11">Requires academic attention</small>
                            </div>
                            <a href="/faculty/reports" class="badge-status-danger text-decoration-none">
                                <%= stats.lowAttendanceCount || 0 %> Students &rarr;
                            </a>
                        </div>
                    </div>

                </div>

                <!-- RIGHT COLUMN: Chart + Weekly Schedule Overview + Recent Sessions -->
                <div class="col-12 col-xl-8 col-lg-7">
                    
                    <!-- Attendance Analytics Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-5">
                            <div class="aesthetic-white-card p-3 h-100 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h3 class="card-section-title mb-0 fs-14">Attendance Distribution</h3>
                                    <span class="badge-pill-soft fs-11"><%= chartData.total %> Marks</span>
                                </div>
                                <div class="position-relative d-flex justify-content-center align-items-center my-2" style="height: 140px;">
                                    <canvas id="facultyAttendanceDonut"></canvas>
                                </div>
                                <div class="d-flex justify-content-around text-center pt-2 border-top-subtle fs-12">
                                    <div><span class="d-block fw-bold text-success"><%= chartData.present %></span>Present</div>
                                    <div><span class="d-block fw-bold text-warning"><%= chartData.late %></span>Late</div>
                                    <div><span class="d-block fw-bold text-danger"><%= chartData.absent %></span>Absent</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-7">
                            <div class="aesthetic-white-card p-3 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h3 class="card-section-title mb-0 fs-14">Weekly Teaching Schedule</h3>
                                    <a href="/faculty/timetable" class="fs-12 text-decoration-none fw-semibold">View Timetable &rarr;</a>
                                </div>
                                <div class="table-responsive">
                                    <table class="table aesthetic-table align-middle mb-0 fs-13">
                                        <thead>
                                            <tr>
                                                <th>Day</th>
                                                <th>Time</th>
                                                <th>Class</th>
                                                <th>Subject</th>
                                                <th>Room</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (weeklySchedule && weeklySchedule.length > 0) { %>
                                                <% weeklySchedule.slice(0, 5).forEach(slot => { %>
                                                <tr>
                                                    <td><span class="badge bg-secondary-subtle text-secondary rounded-pill px-2"><%= slot.day_of_week.substring(0,3) %></span></td>
                                                    <td class="fw-semibold"><%= slot.start_time.substring(0,5) %></td>
                                                    <td><span class="badge-pill-soft"><%= slot.class_name %></span></td>
                                                    <td><%= slot.subject_code %></td>
                                                    <td><code><%= slot.classroom %></code></td>
                                                </tr>
                                                <% }) %>
                                            <% } else { %>
                                                <tr><td colspan="5" class="text-center py-3 text-muted">No timetable slots assigned.</td></tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Academic Week Teaching Schedule Grid Widget -->
                    <%- include('../partials/academic_week_schedule', { schedule: weeklySchedule, userRole: 'faculty' }) %>

                    <!-- Recent Activity Table Card -->
                    <div class="aesthetic-white-card">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                            <div>
                                <h2 class="card-section-title mb-0">Recent Attendance Activity</h2>
                                <small class="text-muted">Last 5 conducted lecture sessions</small>
                            </div>
                            <a href="/faculty/history" class="btn btn-sm btn-outline-secondary rounded-pill">View All History</a>
                        </div>

                        <div class="table-responsive">
                            <table class="table aesthetic-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Subject & Class</th>
                                        <th>Topic</th>
                                        <th>Attendance</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentSessions && recentSessions.length > 0) { %>
                                        <% recentSessions.forEach(sess => { %>
                                        <%
                                            const total = Number(sess.total_marked) || 0;
                                            const attended = (Number(sess.present_count) || 0) + (Number(sess.late_count) || 0);
                                            const pct = total > 0 ? Math.round((attended / total) * 100) : 0;
                                        %>
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark fs-13"><%= formatDate(sess.session_date) %></div>
                                                <small class="text-muted">Session #<%= sess.session_number %></small>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark"><%= sess.subject_code %></div>
                                                <span class="badge-pill-soft"><%= sess.class_name %></span>
                                            </td>
                                            <td>
                                                <span class="text-muted fs-13"><%= sess.topic || 'General Curriculum Lecture' %></span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height:6px; min-width:60px;">
                                                        <div class="progress-bar <%= pct >= 75 ? 'bg-success' : 'bg-danger' %>" style="width: <%= pct %>%"></div>
                                                    </div>
                                                    <span class="fw-bold fs-12 <%= pct >= 75 ? 'text-success' : 'text-danger' %>"><%= pct %>%</span>
                                                </div>
                                                <small class="text-muted fs-11"><%= sess.present_count || 0 %>P / <%= sess.late_count || 0 %>L / <%= sess.absent_count || 0 %>A</small>
                                            </td>
                                            <td class="text-end">
                                                <a href="/faculty/mark/<%= sess.session_id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Edit / View Register">
                                                    <i class="bi bi-pencil-fill me-1"></i>Edit
                                                </a>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">No attendance sessions conducted yet.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

            <!-- SECOND ROW: ASSIGNED CLASSES TABLE -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <div>
                        <h2 class="card-section-title mb-0">My Teaching Allocations (<%= assignments.length %>)</h2>
                        <small class="text-muted">Curriculum classes and sections mapped to your faculty profile</small>
                    </div>
                    <a href="/faculty/sessions" class="btn btn-navy-pill btn-sm">
                        <i class="bi bi-collection-play-fill me-1"></i> Manage Sessions
                    </a>
                </div>
                
                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Subject Code & Title</th>
                                <th>Class & Section</th>
                                <th>Department</th>
                                <th>Enrolled Students</th>
                                <th>Conducted Sessions</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (assignments && assignments.length > 0) { %>
                                <% assignments.forEach(a => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14"><%= a.subject_name %></div>
                                        <span class="badge-pill-soft"><%= a.subject_code %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 fw-bold fs-13"><%= a.class_name %></span>
                                    </td>
                                    <td><span class="fw-semibold text-dark"><%= a.dept_code %></span></td>
                                    <td><span class="fw-bold text-dark"><%= a.student_count %></span> students</td>
                                    <td><span class="fw-bold text-primary"><%= a.session_count %></span> sessions</td>
                                    <td class="text-end">
                                        <a href="/faculty/sessions?assignment_id=<%= a.assignment_id %>" class="btn btn-sm btn-outline-secondary rounded-pill me-1">
                                            Sessions
                                        </a>
                                        <a href="/faculty/mark?class_id=<%= a.class_id %>&subject_id=<%= a.subject_id %>" class="btn btn-navy-pill btn-sm py-1 px-3">
                                            Take Attendance
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No classes assigned yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

<script>
// Mini Calendar Dynamic Generator
document.addEventListener('DOMContentLoaded', function () {
    renderCalendar();

    // Chart.js Attendance Donut
    const ctx = document.getElementById('facultyAttendanceDonut');
    if (ctx) {
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Present', 'Late', 'Absent'],
                datasets: [{
                    data: [<%= chartData.present %>, <%= chartData.late %>, <%= chartData.absent %>],
                    backgroundColor: ['#22c55e', '#eab308', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                return ctx.label + ': ' + ctx.raw + ' marks';
                            }
                        }
                    }
                }
            }
        });
    }
});

let currentCalDate = new Date();

function renderCalendar() {
    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    document.getElementById('calMonthTitle').textContent = `${monthNames[currentCalDate.getMonth()]} ${currentCalDate.getFullYear()}`;
    
    const datesContainer = document.getElementById('calendarDates');
    datesContainer.innerHTML = '';

    const year = currentCalDate.getFullYear();
    const month = currentCalDate.getMonth();
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const startOffset = (firstDay + 6) % 7;

    for (let i = 0; i < startOffset; i++) {
        const empty = document.createElement('span');
        empty.className = 'cal-date-empty';
        datesContainer.appendChild(empty);
    }

    const todayDate = new Date().getDate();
    const isCurrentMonth = new Date().getMonth() === currentCalDate.getMonth() && new Date().getFullYear() === currentCalDate.getFullYear();

    for (let day = 1; day <= daysInMonth; day++) {
        const daySpan = document.createElement('span');
        daySpan.className = 'cal-date-num';
        daySpan.textContent = day;
        if (isCurrentMonth && day === todayDate) {
            daySpan.classList.add('active-lime-circle');
        }
        datesContainer.appendChild(daySpan);
    }
}

function prevMonth() {
    currentCalDate.setMonth(currentCalDate.getMonth() - 1);
    renderCalendar();
}

function nextMonth() {
    currentCalDate.setMonth(currentCalDate.getMonth() + 1);
    renderCalendar();
}
</script>

</body>
</html>
