<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Attendance History Ledger</h1>
                    <p class="hero-sub-title">Audit past lecture sessions, verify student attendance records, and correct past registers</p>
                </div>
                <div class="hero-action-box">
                    <a href="/faculty/sessions" class="btn btn-navy-pill">
                        <i class="bi bi-plus-circle me-1"></i>+ New Lecture Session
                    </a>
                </div>
            </div>

            <!-- FILTERS CARD -->
            <div class="aesthetic-white-card mb-4 p-3">
                <form action="/faculty/history" method="GET" class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <select name="class_id" class="form-select pill-input" onchange="this.form.submit()">
                            <option value="">All Class Sections</option>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.id %>" <%= filters.class_id == c.id ? 'selected' : '' %>>
                                    <%= c.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <input
                            type="date"
                            name="date_from"
                            class="form-control pill-input"
                            value="<%= filters.date_from %>"
                            placeholder="From Date"
                        >
                    </div>
                    <div class="col-6 col-md-3">
                        <input
                            type="date"
                            name="date_to"
                            class="form-control pill-input"
                            value="<%= filters.date_to %>"
                            placeholder="To Date"
                        >
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-navy-pill w-100 justify-content-center">Filter</button>
                        <% if (filters.class_id || filters.date_from || filters.date_to) { %>
                            <a href="/faculty/history" class="btn btn-outline-secondary rounded-pill px-3" title="Clear Filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- HISTORY TABLE CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Recorded Lecture Sessions (<%= sessions.length %>)</h2>
                    <span class="badge-status-lime">Attendance Ledger</span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Lecture Date</th>
                                <th>Class & Section</th>
                                <th>Subject</th>
                                <th>Syllabus Topic</th>
                                <th>Attendance Standings</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (sessions && sessions.length > 0) { %>
                                <% sessions.forEach(sess => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark fs-14">
                                            <%= formatDate(sess.session_date) %>
                                        </div>
                                        <small class="text-muted">Period #<%= sess.session_number %></small>
                                    </td>
                                    <td>
                                        <span class="badge-pill-soft fw-bold"><%= sess.class_name %></span>
                                    </td>
                                    <td>
                                        <div>
                                            <span class="badge-pill-soft me-1"><%= sess.subject_code %></span>
                                            <span class="fw-semibold text-dark"><%= sess.subject_name %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-dark fs-13"><%= sess.topic || 'Regular Lecture' %></div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:6px; min-width:70px;">
                                                <div class="progress-bar <%= sess.pct >= 75 ? 'bg-success' : 'bg-danger' %>" style="width: <%= sess.pct %>%"></div>
                                            </div>
                                            <span class="fw-bold fs-12 <%= sess.pct >= 75 ? 'text-success' : 'text-danger' %>"><%= sess.pct %>%</span>
                                        </div>
                                        <div class="text-muted fs-11 mt-1">
                                            <span class="text-success fw-semibold"><%= sess.present_count || 0 %> Present</span> &bull;
                                            <span class="text-warning-emphasis fw-semibold"><%= sess.late_count || 0 %> Late</span> &bull;
                                            <span class="text-danger fw-semibold"><%= sess.absent_count || 0 %> Absent</span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <a href="/faculty/history/<%= sess.session_id %>" class="btn btn-sm btn-outline-secondary rounded-pill me-1" title="View Full Student Roster">
                                            <i class="bi bi-eye-fill me-1"></i>Roster
                                        </a>
                                        <a href="/faculty/mark/<%= sess.session_id %>" class="btn btn-navy-pill btn-sm px-3" title="Edit Attendance Marks">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-clock-history fs-2 d-block mb-2 text-muted opacity-50"></i>
                                        No attendance history records match your search criteria.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
