<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: typeof notifCount !== 'undefined' ? notifCount : 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 border shadow-xs fs-13">
                            <%= sessionData.class_name %>
                        </span>
                        <span class="badge-pill-soft fs-13">
                            <%= sessionData.subject_code %> &mdash; <%= sessionData.subject_name %>
                        </span>
                    </div>
                    <h1 class="hero-main-title">
                        Lecture Roster: <%= formatDate(sessionData.session_date) %> &bull; Period #<%= sessionData.session_number %>
                    </h1>
                    <p class="hero-sub-title mb-0">
                        Topic: <strong><%= sessionData.topic || 'Regular Lecture' %></strong>
                    </p>
                </div>

                <div class="hero-action-box d-flex align-items-center gap-2">
                    <a href="/faculty/history" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Back to History
                    </a>
                    <a href="/faculty/mark/<%= sessionData.id %>" class="btn btn-navy-pill">
                        <i class="bi bi-pencil-square me-1"></i> Edit Register
                    </a>
                </div>
            </div>

            <!-- SESSION SUMMARY CARD -->
            <%
                let presentCount = 0, lateCount = 0, absentCount = 0;
                studentRecords.forEach(s => {
                    if (s.status === 'present') presentCount++;
                    else if (s.status === 'late') lateCount++;
                    else absentCount++;
                });
                const total = studentRecords.length;
                const attended = presentCount + lateCount;
                const pct = total > 0 ? Math.round((attended / total) * 100) : 0;
            %>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="aesthetic-white-card p-3 text-center">
                        <div class="fs-12 text-muted fw-bold text-uppercase">Total Enrolled</div>
                        <div class="fs-22 fw-800 text-dark"><%= total %></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="aesthetic-white-card p-3 text-center">
                        <div class="fs-12 text-muted fw-bold text-uppercase">Present</div>
                        <div class="fs-22 fw-800 text-success"><%= presentCount %></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="aesthetic-white-card p-3 text-center">
                        <div class="fs-12 text-muted fw-bold text-uppercase">Late</div>
                        <div class="fs-22 fw-800 text-warning"><%= lateCount %></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="aesthetic-white-card p-3 text-center">
                        <div class="fs-12 text-muted fw-bold text-uppercase">Absent</div>
                        <div class="fs-22 fw-800 text-danger"><%= absentCount %></div>
                    </div>
                </div>
            </div>

            <!-- STUDENTS ROSTER CARD -->
            <div class="aesthetic-white-card">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                    <h2 class="card-section-title mb-0">Student Attendance List (<%= studentRecords.length %>)</h2>
                    <span class="badge <%= pct >= 75 ? 'badge-status-lime' : 'badge-status-danger' %>">
                        <%= pct %>% Class Attendance
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table aesthetic-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Roll Number</th>
                                <th>Student Name</th>
                                <th>Email</th>
                                <th>Attendance Status</th>
                                <th class="text-end">Marked Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (studentRecords && studentRecords.length > 0) { %>
                                <% studentRecords.forEach((stu, idx) => { %>
                                <tr>
                                    <td class="text-muted fs-12"><%= idx + 1 %></td>
                                    <td>
                                        <code><%= stu.roll_number %></code>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= stu.full_name %></div>
                                    </td>
                                    <td>
                                        <span class="text-muted fs-13"><%= stu.email %></span>
                                    </td>
                                    <td>
                                        <% if (stu.status === 'present') { %>
                                            <span class="badge-status-lime">Present</span>
                                        <% } else if (stu.status === 'late') { %>
                                            <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 fw-semibold">Late</span>
                                        <% } else { %>
                                            <span class="badge-status-danger">Absent</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end text-muted fs-12">
                                        <%= stu.marked_at ? new Date(stu.marked_at).toLocaleString() : 'N/A' %>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        No student records found for this session.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

</body>
</html>
