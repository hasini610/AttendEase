<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body class="aesthetic-app-body">

<div class="aesthetic-layout-container">
    <%- include('../partials/sidebar', { user, activePage }) %>

    <div class="aesthetic-main-canvas">
        <%- include('../partials/topbar', { user, pageTitle, notifCount: notifCount || 0 }) %>

        <div class="aesthetic-content-area">
            <%- include('../partials/flash') %>

            <!-- HERO STATS HEADER -->
            <div class="dashboard-hero-header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div class="hero-left-titles">
                    <h1 class="hero-main-title">Student Dashboard</h1>
                    <p class="hero-sub-title">
                        Welcome back, <strong><%= user.full_name %></strong> &bull; <%= student.department_name %> (<%= student.class_name || 'Enrolled' %>) &bull; Roll: <code><%= student.roll_number %></code>
                    </p>
                </div>

                <div class="hero-right-stats d-flex flex-wrap align-items-center gap-4">
                    <div class="hero-stat-item">
                        <div class="hero-stat-label">Enrolled Subjects</div>
                        <div class="hero-stat-value"><%= subjectStats.length %></div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-label">Attended / Total</div>
                        <div class="hero-stat-value"><%= totalAttended %> <span class="hero-stat-unit">/ <%= totalSessions %></span></div>
                    </div>
                    <div class="hero-stat-item">
                        <div class="hero-stat-label">Overall Rate</div>
                        <div class="hero-stat-value <%= overallPct < threshold ? 'text-danger' : 'text-lime-glow' %>">
                            <%= overallPct %>%
                        </div>
                    </div>
                    <div class="hero-action-box">
                        <a href="/student/attendance" class="btn btn-navy-pill">
                            <i class="bi bi-calendar2-check me-2"></i>My Attendance
                        </a>
                    </div>
                </div>
            </div>

            <!-- LOW ATTENDANCE WARNING BANNER (When below threshold) -->
            <% if (lowSubjects && lowSubjects.length > 0) { %>
            <div class="aesthetic-alert-banner alert-warning-glow mb-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="alert-icon-pill bg-danger text-white"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold mb-1 text-danger">Low Attendance Warning (<%= threshold %>% Minimum Required)</h5>
                        <p class="mb-2 fs-13 text-dark">
                            You are currently falling short in <strong><%= lowSubjects.length %></strong> of your enrolled subjects. Attend the next consecutive lectures to restore your safe eligibility status:
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <% lowSubjects.forEach(ls => { %>
                                <span class="badge bg-light text-dark border p-2 fs-12">
                                    <strong class="text-danger"><%= ls.subject_code %></strong>: <%= ls.pct %>% 
                                    (<%= ls.attended %>/<%= ls.total %>) &bull; 
                                    <span class="text-primary fw-bold">+<%= ls.neededToPass %> sessions needed</span>
                                </span>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- MAIN ROW: LEFT (Calendar + Today's Schedule) & RIGHT (Analytics + Recent Activity) -->
            <div class="row g-4 mb-4">
                
                <!-- LEFT COLUMN: Mini Calendar & Today's Schedule -->
                <div class="col-12 col-xl-4 col-lg-5">
                    
                    <!-- 1. Mini Calendar Card -->
                    <div class="aesthetic-calendar-card mb-3">
                        <div class="calendar-card-header d-flex align-items-center justify-content-between mb-3">
                            <span class="cal-month-title" id="calMonthTitle">October 2026</span>
                            <div class="cal-nav-arrows">
                                <button type="button" class="cal-arrow-btn" onclick="prevMonth()"><i class="bi bi-chevron-left"></i></button>
                                <button type="button" class="cal-arrow-btn" onclick="nextMonth()"><i class="bi bi-chevron-right"></i></button>
                            </div>
                        </div>

                        <div class="calendar-days-row">
                            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                        </div>
                        <div class="calendar-grid-dates" id="calendarDates"></div>
                    </div>

                    <!-- 2. Today's Lectures Card (Real MySQL Timetable) -->
                    <div class="aesthetic-white-card checklist-card mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h2 class="card-section-title mb-0">Today's Schedule</h2>
                                <small class="text-muted"><%= todayDay %></small>
                            </div>
                            <a href="/student/timetable" class="btn-text-action fs-12">Full Week &rarr;</a>
                        </div>
                        
                        <div class="today-lectures-list">
                            <% if (todayLectures && todayLectures.length > 0) { %>
                                <% todayLectures.forEach(slot => { %>
                                    <div class="p-3 mb-2 rounded-3 border bg-light d-flex align-items-start justify-content-between">
                                        <div>
                                            <div class="fw-bold text-dark"><%= slot.subject_name %></div>
                                            <div class="fs-12 text-muted">
                                                <i class="bi bi-clock me-1"></i><%= slot.start_time.slice(0,5) %> - <%= slot.end_time.slice(0,5) %> &bull; 
                                                <i class="bi bi-geo-alt ms-1"></i><%= slot.classroom %>
                                            </div>
                                            <div class="fs-12 text-secondary mt-1">
                                                <i class="bi bi-person me-1"></i><%= slot.faculty_name %>
                                            </div>
                                        </div>
                                        <span class="badge-status-lime fs-11"><%= slot.subject_code %></span>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-4 text-muted">
                                    <i class="bi bi-calendar-x fs-2 d-block mb-1 text-secondary"></i>
                                    <span>No lectures scheduled for <%= todayDay %>.</span>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- 3. Academic Standing Card -->
                    <div class="aesthetic-white-card">
                        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom-subtle">
                            <h2 class="card-section-title mb-0">Academic Summary</h2>
                            <span class="badge-status-lime">Enrolled</span>
                        </div>
                        <ul class="list-unstyled mb-0 fs-13">
                            <li class="d-flex justify-content-between py-2 border-bottom-subtle">
                                <span class="text-muted">Department</span>
                                <span class="fw-bold text-dark"><%= student.department_name %></span>
                            </li>
                            <li class="d-flex justify-content-between py-2 border-bottom-subtle">
                                <span class="text-muted">Section</span>
                                <span class="fw-bold text-dark"><%= student.class_name %></span>
                            </li>
                            <li class="d-flex justify-content-between py-2 border-bottom-subtle">
                                <span class="text-muted">Total Classes Conducted</span>
                                <span class="fw-bold text-dark"><%= totalSessions %></span>
                            </li>
                            <li class="d-flex justify-content-between py-2 border-bottom-subtle">
                                <span class="text-muted">Attended (Present + Late)</span>
                                <span class="fw-bold text-success"><%= totalAttended %></span>
                            </li>
                            <li class="d-flex justify-content-between py-2">
                                <span class="text-muted">Absences</span>
                                <span class="fw-bold text-danger"><%= totalAbsent %></span>
                            </li>
                        </ul>
                    </div>

                </div>

                <!-- RIGHT COLUMN: Subject Chart & Recent Attendance History -->
                <div class="col-12 col-xl-8 col-lg-7">
                    
                    <!-- Subject Analytics Bar Chart Card -->
                    <div class="aesthetic-white-card mb-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between pb-3 mb-3 border-bottom-subtle">
                            <div>
                                <h2 class="card-section-title mb-0">Subject Attendance Performance</h2>
                                <small class="text-muted">Target threshold: <%= threshold %>%</small>
                            </div>
                            <a href="/student/attendance" class="btn-text-action">Detailed Breakdown &rarr;</a>
                        </div>
                        <div class="chart-canvas-box" style="height:260px; position:relative;">
                            <canvas id="studentSubjectChart"></canvas>
                        </div>
                    </div>

                    <!-- Academic Week Class Schedule Grid Widget -->
                    <%- include('../partials/academic_week_schedule', { schedule: weeklySchedule, userRole: 'student' }) %>

                    <!-- Recent Attendance Activity Table (Last 5 sessions) -->
                    <div class="aesthetic-white-card mb-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between pb-3 mb-3 border-bottom-subtle">
                            <div>
                                <h2 class="card-section-title mb-0">Recent Attendance Logs</h2>
                                <small class="text-muted">Latest 5 class sessions recorded</small>
                            </div>
                            <a href="/student/history" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                View Full History <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table aesthetic-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Subject</th>
                                        <th>Faculty</th>
                                        <th>Topic</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentAttendance && recentAttendance.length > 0) { %>
                                        <% recentAttendance.forEach(r => { %>
                                        <tr>
                                            <td class="text-nowrap">
                                                <i class="bi bi-calendar3 me-1 text-muted"></i>
                                                <%= formatDate(r.session_date) %>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border me-1"><%= r.subject_code %></span>
                                                <span class="fw-bold text-dark"><%= r.subject_name %></span>
                                            </td>
                                            <td class="text-secondary fs-13"><%= r.faculty_name %></td>
                                            <td class="text-muted fs-13"><%= r.topic || 'Regular Lecture' %></td>
                                            <td>
                                                <% if (r.status === 'present') { %>
                                                    <span class="badge-status-lime"><i class="bi bi-check-circle me-1"></i>Present</span>
                                                <% } else if (r.status === 'late') { %>
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Late</span>
                                                <% } else { %>
                                                    <span class="badge-status-danger"><i class="bi bi-x-circle me-1"></i>Absent</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">
                                                No attendance logs recorded yet.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Subject Summaries Quick Table -->
                    <div class="aesthetic-white-card">
                        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom-subtle">
                            <h2 class="card-section-title mb-0">Enrolled Subjects Quick Status</h2>
                            <span class="badge-pill-soft"><%= subjectStats.length %> Subjects</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table aesthetic-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Faculty</th>
                                        <th>Attended / Total</th>
                                        <th>Percentage</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (subjectStats && subjectStats.length > 0) { %>
                                        <% subjectStats.forEach(s => { %>
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark"><%= s.subject_name %></div>
                                                <small class="text-muted"><%= s.subject_code %> &bull; <%= s.credits %> Credits</small>
                                            </td>
                                            <td class="fs-13 text-secondary"><%= s.faculty_name %></td>
                                            <td><strong><%= s.attended %></strong> / <%= s.total %></td>
                                            <td style="min-width: 140px;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress aesthetic-progress flex-grow-1" style="height: 7px;">
                                                        <div
                                                            class="progress-bar <%= s.pct >= threshold ? 'bg-lime-glow' : 'bg-danger' %>"
                                                            style="width: <%= s.pct %>%;"
                                                        ></div>
                                                    </div>
                                                    <span class="fw-bold fs-13"><%= s.pct %>%</span>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (s.pct >= threshold) { %>
                                                    <span class="badge-status-lime">Eligible</span>
                                                <% } else { %>
                                                    <span class="badge-status-danger" title="<%= s.neededToPass %> sessions needed">
                                                        Shortage (+<%= s.neededToPass %>)
                                                    </span>
                                                <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">No enrolled subjects found.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/scripts') %>

<script>
// Chart.js Subject Attendance Performance Bar Chart
document.addEventListener('DOMContentLoaded', function () {
    const ctx = document.getElementById('studentSubjectChart');
    if (ctx) {
        <% if (subjectStats && subjectStats.length > 0) { %>
            const labels    = <%- JSON.stringify(subjectStats.map(s => s.subject_code)) %>;
            const data      = <%- JSON.stringify(subjectStats.map(s => s.pct)) %>;
            const threshold = <%= threshold %>;

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Attendance %',
                        data,
                        backgroundColor: data.map(v => v >= threshold ? '#cbf946' : '#ff7675'),
                        borderColor: data.map(v => v >= threshold ? '#a4df14' : '#d63031'),
                        borderWidth: 1.5,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `Attendance: ${context.parsed.y}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            grid: { color: 'rgba(0,0,0,0.05)' },
                            ticks: { callback: v => v + '%' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        <% } %>
    }

    renderCalendar();
});

let currentCalDate = new Date();

function renderCalendar() {
    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    const monthTitle = document.getElementById('calMonthTitle');
    if (monthTitle) {
        monthTitle.textContent = `${monthNames[currentCalDate.getMonth()]} ${currentCalDate.getFullYear()}`;
    }
    
    const datesContainer = document.getElementById('calendarDates');
    if (!datesContainer) return;
    datesContainer.innerHTML = '';

    const year = currentCalDate.getFullYear();
    const month = currentCalDate.getMonth();
    const firstDay = new Date(year, month, 1).getDay(); // 0 = Sun
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    // Monday start offset: 0 -> Sun (offset 6), 1 -> Mon (offset 0), etc.
    const startOffset = (firstDay + 6) % 7;

    for (let i = 0; i < startOffset; i++) {
        const empty = document.createElement('span');
        empty.className = 'cal-date-empty';
        datesContainer.appendChild(empty);
    }

    const today = new Date();
    for (let day = 1; day <= daysInMonth; day++) {
        const daySpan = document.createElement('span');
        daySpan.className = 'cal-date-num';
        daySpan.textContent = day;
        if (today.getDate() === day && today.getMonth() === month && today.getFullYear() === year) {
            daySpan.classList.add('active-lime-circle');
        }
        datesContainer.appendChild(daySpan);
    }
}

function prevMonth() {
    currentCalDate.setMonth(currentCalDate.getMonth() - 1);
    renderCalendar();
}

function nextMonth() {
    currentCalDate.setMonth(currentCalDate.getMonth() + 1);
    renderCalendar();
}
</script>

</body>
</html>
